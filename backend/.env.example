PORT=5000
NODE_ENV=development

# Database configuration
# Set DB_DIALECT=postgres for PostgreSQL, or DB_DIALECT=sqlite for zero-config local development
DB_DIALECT=sqlite
DB_STORAGE=./data/manufacturing_erp.sqlite

# PostgreSQL settings (active when DB_DIALECT=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manufacturing_erp
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret
JWT_SECRET=mfg_erp_super_secret_jwt_key_2026_antigravity
JWT_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=./uploads

# Client URL
CLIENT_URL=http://localhost:5173
